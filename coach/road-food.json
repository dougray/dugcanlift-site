  "rules": [
    "Grilled over fried. The same chicken breaded and fried carries more fat and fewer grams of protein per calorie.",
    "Double the protein instead of a bigger bun or a larger size.",
    "Sauces and dressings on the side, so you decide how much goes on.",
    "Skip the sugary drink. Water, unsweetened tea, black coffee or a diet soda cost nothing.",
    "A side salad or fruit instead of fries.",
    {
      "text": "A single patty with extra lettuce and tomato, and hold the mayo-based sauce.",
      "kinds": [
        "burgers"
      ]
    },
    {
      "text": "Grilled nuggets or a grilled sandwich. A nugget count is easy to size to what you have left.",
      "kinds": [
        "chicken"
      ]
    },
    {
      "text": "A smaller sandwich with double meat beats a bigger one with single.",
      "kinds": [
        "sandwiches"
      ]
    },
    {
      "text": "A protein box, egg bites or a wrap over a pastry, and the drink unsweetened.",
      "kinds": [
        "coffee"
      ]
    },
    {
      "text": "From the kitchen counter or the cooler, a wrap or half sub with lean meat over anything from the roller grill or the fryer.",
      "kinds": [
        "gas-station-kitchen"
      ]
    },
    {
      "text": "Jerky, string cheese, Greek yogurt, eggs, a tuna pouch or a protein shake cover the protein. Add fruit for the carbs.",
      "kinds": [
        "snacks"
      ]
    },
    {
      "text": "Check the serving on the label. A bag of jerky or nuts is often two or more servings, and nuts are calorie-dense.",
      "kinds": [
        "snacks"
      ]
    }
  ]
}
