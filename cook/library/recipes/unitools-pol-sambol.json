    "servings": 6,
    "ingredients": [
      {
        "rawText": "250 g Grated coconut",
        "item": "grated coconut",
        "qty": 250,
        "unit": "g",
        "grams": 250,
        "note": "fresh or thawed"
      },
      {
        "rawText": "2 tbsp Chilli flakes",
        "item": "chilli flakes",
        "qty": 2,
        "unit": "tbsp"
      },
      {
        "rawText": "1 Red onion",
        "item": "red onion",
        "qty": 1,
        "note": "very finely chopped"
      },
      {
        "rawText": "2 tbsp Maldive fish",
        "item": "maldive fish",
        "qty": 2,
        "unit": "tbsp"
      },
      {
        "rawText": "1 Lime",
        "item": "lime",
        "qty": 1,
        "note": "juiced"
      },
      {
        "rawText": "Salt, to taste",
        "item": "salt"
      }
    ],
    "steps": [
      "Pound the chilli flakes with the salt and the Maldive fish to a rough paste.",
      "Add the onion and keep pounding: it should give up its juice and stain the paste.",
      "Work the coconut in by hand, rubbing the mixture between your palms until it turns evenly red.",
      "Add the lime juice, mix and taste. The sambol should be hot, sour and salty at once."
    ],
