    "ingredients": [
      {
        "rawText": "3 kg Fleshy red peppers",
        "item": "fleshy red peppers",
        "qty": 3,
        "unit": "kg",
        "grams": 3000
      },
      {
        "rawText": "600 g Aubergines",
