        "note": "chopped"
      },
      {
        "rawText": "1 tsp Sichuan peppercorns",
        "item": "sichuan peppercorns",
        "qty": 1,
        "unit": "tsp",
        "note": "ground"
      },
      {
        "rawText": "3 cloves Garlic",
