        "qty": 5,
        "unit": "slice"
      },
      {
        "rawText": "5 Kaffir lime leaves",
        "item": "kaffir lime leaves",
        "qty": 5
      },
      {
        "rawText": "200 g Mushrooms",
        "item": "mushrooms",
        "qty": 200,
        "unit": "g",
        "grams": 200
      },
      {
        "rawText": "3 Chillies",
        "item": "chillies",
        "qty": 3
      },
      {
        "rawText": "3 tbsp Fish sauce",
        "item": "fish sauce",
        "qty": 3,
        "unit": "tbsp"
      },
