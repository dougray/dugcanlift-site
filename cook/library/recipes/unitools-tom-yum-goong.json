    "servings": 4,
    "ingredients": [
      {
        "rawText": "400 g Prawns",
        "item": "prawns",
        "qty": 400,
        "unit": "g",
        "grams": 400,
        "note": "heads on, keep the shells"
      },
      {
        "rawText": "1 l Water or stock",
        "item": "water or stock",
        "qty": 1,
        "unit": "l"
      },
      {
        "rawText": "2 Lemongrass",
