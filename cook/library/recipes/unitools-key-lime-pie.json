    "servings": 8,
    "ingredients": [
      {
        "rawText": "250 g Graham crackers or digestives",
        "item": "graham crackers or digestives",
        "qty": 250,
        "unit": "g",
        "grams": 250
      },
      {
        "rawText": "110 g Butter",
        "item": "butter",
        "qty": 110,
