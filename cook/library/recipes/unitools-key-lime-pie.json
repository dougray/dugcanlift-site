        "note": "melted"
      },
      {
        "rawText": "50 g Sugar",
        "item": "sugar",
        "qty": 50,
        "unit": "g",
        "grams": 50
      },
      {
        "rawText": "400 g Condensed milk",
        "item": "condensed milk",
        "qty": 400,
        "unit": "g",
        "grams": 400
      },
      {
        "rawText": "4 Egg yolks",
        "item": "egg yolks",
        "qty": 4
      },
      {
        "rawText": "8 Limes",
