    "servings": 4,
    "ingredients": [
      {
        "rawText": "500 g Curd cheese, 5-9% fat",
        "item": "curd cheese, 5-9% fat",
        "qty": 500,
        "unit": "g",
        "grams": 500,
        "note": "dry, drained"
      },
      {
        "rawText": "1 Egg",
        "item": "egg",
        "qty": 1
      },
      {
        "rawText": "3 tbsp Plain flour",
        "item": "plain flour",
        "qty": 3,
        "unit": "tbsp",
        "note": "plus a little for your hands"
      },
      {
        "rawText": "1 tbsp Sugar",
        "item": "sugar",
        "qty": 1,
        "unit": "tbsp"
      },
      {
        "rawText": "1 tsp Vanilla sugar",
        "item": "vanilla sugar",
        "qty": 1,
        "unit": "tsp"
      },
      {
        "rawText": "1 pinch Salt",
        "item": "salt",
        "qty": 1,
        "unit": "pinch"
      },
      {
        "rawText": "30 g Butter for frying",
        "item": "butter for frying",
        "qty": 30,
        "unit": "g",
        "grams": 30
      },
      {
        "rawText": "Sour cream and jam, to taste",
        "item": "sour cream and jam"
      }
    ],
    "steps": [
      "Push the curd through a sieve or blitz it. Grainy curd makes grainy syrniki; this step is not optional.",
      "Work in the egg, sugar, vanilla and salt, then the flour. The mixture stays sticky; that is correct.",
      "With wet or lightly floured hands shape discs about a centimetre and a half thick. Thicker and the middle stays raw, thinner and they dry out.",
      "Fry over medium heat with a lid on, three or four minutes a side. The lid matters more than the butter: it steams the middle through."
    ],
