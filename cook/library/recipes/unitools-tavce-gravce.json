    "ingredients": [
      {
        "rawText": "500 g White beans",
        "item": "white beans",
        "qty": 500,
        "unit": "g",
        "grams": 500,
        "note": "soaked overnight"
      },
      {
        "rawText": "3 Onions",
        "item": "onions",
