        "note": "chopped by hand"
      },
      {
        "rawText": "200 g Pork",
        "item": "pork",
        "qty": 200,
        "unit": "g",
        "grams": 200,
        "note": "chopped by hand"
      },
      {
        "rawText": "2 Onion",
        "item": "onion",
        "qty": 2,
        "note": "very finely chopped"
      },
      {
        "rawText": "200 ml Iced water for the filling",
        "item": "iced water for the filling",
        "qty": 200,
        "unit": "ml"
      },
      {
        "rawText": "1 sprig Coriander",
        "item": "coriander",
        "qty": 1,
        "unit": "sprig"
      },
      {
        "rawText": "1 tsp Ground cumin",
        "item": "ground cumin",
