    "servings": 4,
    "ingredients": [
      {
        "rawText": "500 g Plain flour",
        "item": "plain flour",
        "qty": 500,
        "unit": "g",
        "grams": 500
      },
      {
        "rawText": "220 ml Water for the dough",
        "item": "water for the dough",
        "qty": 220,
        "unit": "ml"
      },
