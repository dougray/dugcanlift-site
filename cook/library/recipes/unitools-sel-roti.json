        "grams": 600,
        "note": "soaked overnight"
      },
      {
        "rawText": "150 g Sugar",
        "item": "sugar",
        "qty": 150,
        "unit": "g",
        "grams": 150
      },
      {
        "rawText": "60 g Ghee",
