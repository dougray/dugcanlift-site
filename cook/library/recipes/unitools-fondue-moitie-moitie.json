        "item": "dry white wine",
        "qty": 300,
        "unit": "ml"
      },
      {
        "rawText": "2 tbsp Cornflour",
        "item": "cornflour",
        "qty": 2,
        "unit": "tbsp"
      },
      {
        "rawText": "1 clove Garlic",
        "item": "garlic",
