    "ingredients": [
      {
        "rawText": "600 g Cornmeal",
        "item": "cornmeal",
        "qty": 600,
        "unit": "g",
        "grams": 600,
        "note": "coarse"
      },
      {
        "rawText": "300 g Butter",
        "item": "butter",
        "qty": 300,
        "unit": "g",
        "grams": 300,
        "note": "softened"
      },
      {
        "rawText": "400 g Sugar",
        "item": "sugar",
        "qty": 400,
        "unit": "g",
        "grams": 400
      },
      {
        "rawText": "6 Egg yolks",
        "item": "egg yolks",
        "qty": 6
      },
      {
        "rawText": "1 tsp Bicarbonate of soda",
        "item": "bicarbonate of soda",
        "qty": 1,
        "unit": "tsp"
      },
      {
        "rawText": "1 tsp Vanilla",
        "item": "vanilla",
