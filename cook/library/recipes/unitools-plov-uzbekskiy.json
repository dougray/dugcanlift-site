    "ingredients": [
      {
        "rawText": "800 g Lamb on the bone",
        "item": "lamb on the bone",
        "qty": 800,
        "unit": "g",
        "grams": 800
      },
      {
        "rawText": "100 g Lamb tail fat",
        "item": "lamb tail fat",
        "qty": 100,
        "unit": "g",
        "grams": 100,
        "note": "or vegetable oil"
      },
      {
        "rawText": "700 g Devzira or another firm rice",
        "item": "devzira or another firm rice",
        "qty": 700,
        "unit": "g",
        "grams": 700
      },
      {
