    "servings": 20,
    "ingredients": [
      {
        "rawText": "150 g Rolled oats",
        "item": "rolled oats",
        "qty": 150,
        "unit": "g",
        "grams": 150
      },
      {
        "rawText": "150 g Flour",
        "item": "flour",
