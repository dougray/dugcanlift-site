      },
      {
        "rawText": "100 g Desiccated coconut",
        "item": "desiccated coconut",
        "qty": 100,
        "unit": "g",
        "grams": 100
      },
      {
        "rawText": "150 g Brown sugar",
        "item": "brown sugar",
        "qty": 150,
        "unit": "g",
        "grams": 150
      },
      {
        "rawText": "150 g Butter",
        "item": "butter",
        "qty": 150,
        "unit": "g",
        "grams": 150
      },
      {
        "rawText": "3 tbsp Golden syrup",
        "item": "golden syrup",
        "qty": 3,
        "unit": "tbsp"
      },
      {
        "rawText": "1 tsp Bicarbonate of soda",
        "item": "bicarbonate of soda",
        "qty": 1,
        "unit": "tsp"
      },
      {
        "rawText": "2 tbsp Boiling water",
        "item": "boiling water",
