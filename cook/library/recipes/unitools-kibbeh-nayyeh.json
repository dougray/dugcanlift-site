    "schemaVersion": 1,
    "name": "Kibbeh nayyeh",
    "sourceURL": "https://theunitools.com/en/data",
    "sourceAuthor": "UniTools — theunitools.com",
    "servings": 4,
    "ingredients": [
      {
        "rawText": "120 g Fine bulgur",
        "item": "fine bulgur",
        "qty": 120,
        "unit": "g",
        "grams": 120
      },
      {
        "rawText": "500 g Freshest lamb",
        "item": "freshest lamb",
        "qty": 500,
        "unit": "g",
        "grams": 500,
        "note": "loin or leg, fully trimmed"
      },
      {
        "rawText": "1 Onion",
        "item": "onion",
        "qty": 1
      },
      {
        "rawText": "1 tsp Seven-spice mix",
        "item": "seven-spice mix",
        "qty": 1,
        "unit": "tsp"
      },
      {
        "rawText": "1 tsp Dried mint",
        "item": "dried mint",
        "qty": 1,
        "unit": "tsp"
      },
      {
        "rawText": "100 ml Iced water",
        "item": "iced water",
        "qty": 100,
        "unit": "ml"
      },
      {
        "rawText": "60 ml Olive oil",
        "item": "olive oil",
        "qty": 60,
        "unit": "ml",
        "note": "to serve"
      },
      {
        "rawText": "Mint and white onion to serve, to taste",
        "item": "mint and white onion to serve"
      },
      {
        "rawText": "Salt and pepper, to taste",
        "item": "salt and pepper"
      }
    ],
    "steps": [
      "Soak the bulgur in cold water for ten minutes, drain and squeeze it dry. Chill the bowl — everything for nayyeh must stay cold.",
      "Trim the lamb of fat and silverskin down to clean muscle and cube it. Blitz with the onion to a smooth paste without letting the bowl warm up.",
      "Add the bulgur, spices, mint and salt. Knead, wetting your hands with iced water, until the paste is smooth and glossy.",
      "Spread the paste over a cold plate about a centimetre and a half thick, press grooves with the back of a spoon and pour the olive oil over generously.",
      "Serve at once, with mint leaves, white onion wedges and flatbread. Nayyeh is not kept: leftovers are fried as patties the same evening."
    ],
