    "servings": 12,
    "ingredients": [
      {
        "rawText": "400 g Puff pastry",
        "item": "puff pastry",
        "qty": 400,
        "unit": "g",
        "grams": 400
      },
      {
        "rawText": "250 ml Milk",
        "item": "milk",
